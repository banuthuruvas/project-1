# Build stage - uses pnpm monorepo
FROM dhi.io/node:24.14.0-alpine3.22-dev AS build
ARG BUILD_ENV=staging
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# Copy workspace config and lockfile first for better caching
COPY src/frontend/package.json src/frontend/pnpm-workspace.yaml src/frontend/pnpm-lock.yaml ./
COPY src/frontend/apps/main/package.json apps/main/package.json
COPY src/frontend/apps/auth/package.json apps/auth/package.json
COPY src/frontend/packages/ui/package.json packages/ui/package.json
COPY src/frontend/packages/platform/package.json packages/platform/package.json
COPY src/frontend/packages/contracts/package.json packages/contracts/package.json

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Copy all source files
COPY src/frontend/apps/main/ apps/main/
COPY src/frontend/apps/auth/ apps/auth/
COPY src/frontend/packages/ packages/

# Build shared packages first, then apps
RUN pnpm run build:contracts && pnpm run build:ui && pnpm run build:platform
RUN cd apps/main && pnpm run build:${BUILD_ENV}
RUN cd apps/auth && pnpm run build:${BUILD_ENV}

# Production stage
FROM dhi.io/nginx:1.29.5-debian13-dev

# Copy main frontend files
COPY --from=build /app/apps/main/dist /usr/share/nginx/html/main

# Copy auth (login) frontend files
COPY --from=build /app/apps/auth/dist /usr/share/nginx/html/login

COPY build/maintenance.html /usr/share/nginx/html/maintenance.html
COPY build/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
