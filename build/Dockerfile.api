# Build stage
FROM dhi.io/dotnet:10.0.103-sdk-alpine3.22 AS build
WORKDIR /src

# Copy project files and restore as distinct layers for better caching
COPY ["src/backend/API/API.csproj", "API/"]
COPY ["src/backend/Libraries/Data/Data.csproj", "Libraries/Data/"]
COPY ["src/backend/Libraries/Domain/Domain.csproj", "Libraries/Domain/"]
COPY ["src/backend/Libraries/Services/Services.csproj", "Libraries/Services/"]
COPY ["src/backend/Libraries/Shared/Shared.csproj", "Libraries/Shared/"]

# Restore dependencies
RUN dotnet restore "API/API.csproj" --use-current-runtime

# Copy source code
COPY ["src/backend/API/", "API/"]
COPY ["src/backend/Libraries/", "Libraries/"]

# Publish with optimizations
RUN dotnet publish "API/API.csproj" \
    -c Release \
    -o /app/publish \
    --use-current-runtime \
    --self-contained false \
    --no-restore \
    /p:PublishTrimmed=false \
    /p:PublishSingleFile=false

# Remove unnecessary files
RUN rm -f /app/publish/appsettings.json \
    && rm -f /app/publish/*.pdb \
    && find /app/publish -name "*.xml" -delete

# Runtime stage
FROM dhi.io/aspnetcore:10.0.3-alpine3.22
WORKDIR /app

# Install runtime dependencies and prepare writable application directories.
USER root
RUN apk add --no-cache \
    icu-libs \
    && mkdir -p /app/files \
    && chown -R 65532:65532 /app

# Copy published app
COPY --from=build --chown=65532:65532 /app/publish .

# Set environment variables
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# Switch to non-root user
USER 65532:65532

EXPOSE 8080
ENTRYPOINT ["dotnet", "API.dll"]
