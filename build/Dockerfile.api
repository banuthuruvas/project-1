# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0.102 AS build
WORKDIR /src

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Copy project files and restore as distinct layers for better caching
COPY ["src/backend/Directory.Build.props", "./"]
COPY ["src/backend/Directory.Packages.props", "./"]
COPY ["global.json", "./"]
COPY ["src/backend/BuildingBlocks/BuildingBlocks/BuildingBlocks.csproj", "BuildingBlocks/BuildingBlocks/"]
COPY ["src/backend/BuildingBlocks/Validation/Validation.csproj", "BuildingBlocks/Validation/"]
COPY ["src/backend/Core/Contracts/Contracts.csproj", "Core/Contracts/"]
COPY ["src/backend/Core/Domain/Domain.csproj", "Core/Domain/"]
COPY ["src/backend/Core/Application/Application.csproj", "Core/Application/"]
COPY ["src/backend/Infrastructure/AI/AI.csproj", "Infrastructure/AI/"]
COPY ["src/backend/Infrastructure/Integration/Integration.csproj", "Infrastructure/Integration/"]
COPY ["src/backend/Infrastructure/Persistence/Persistence.csproj", "Infrastructure/Persistence/"]
COPY ["src/backend/Hosts/Api/Api.csproj", "Hosts/Api/"]

# Restore dependencies
RUN dotnet restore "Hosts/Api/Api.csproj" --use-current-runtime

# Copy source code
COPY ["src/backend/BuildingBlocks/", "BuildingBlocks/"]
COPY ["src/backend/Core/", "Core/"]
COPY ["src/backend/Infrastructure/", "Infrastructure/"]
COPY ["src/backend/Hosts/Api/", "Hosts/Api/"]
# Persistence.csproj embeds this logo through a path relative to Infrastructure/Persistence.
COPY ["src/frontend/apps/main/src/assets/nie-logo.svg", "/frontend/apps/main/src/assets/nie-logo.svg"]
# Api.csproj publishes this non-secret, local-development profile catalog as a linked resource.
COPY ["src/frontend/apps/main/public/test-profiles.json", "/frontend/apps/main/public/test-profiles.json"]

# Publish with optimizations
RUN dotnet publish "Hosts/Api/Api.csproj" \
    -c Release \
    -o /app/publish \
    --use-current-runtime \
    --self-contained false \
    --no-restore \
    /p:PublishTrimmed=false \
    /p:PublishSingleFile=false

RUN pwsh /app/publish/playwright.ps1 install chromium

# Remove unnecessary files
RUN rm -f /app/publish/appsettings.json \
    && rm -f /app/publish/*.pdb \
    && find /app/publish -name "*.xml" -delete

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        fontconfig \
        fonts-liberation \
        fonts-noto-cjk \
        fonts-noto-color-emoji \
        libasound2t64 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libglib2.0-0 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        libxshmfence1 \
        libxtst6 \
        tzdata \
        xdg-utils \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1001 appgroup \
    && useradd --uid 1001 --gid appgroup --home-dir /app --shell /usr/sbin/nologin --no-create-home appuser
COPY --from=build --chown=appuser:appgroup /app/publish .
COPY --from=build --chown=appuser:appgroup /ms-playwright /ms-playwright

ENV Kestrel__Endpoints__Http__Url=http://+:8080 \
    Kestrel__Endpoints__Http__Protocols=Http1 \
    Kestrel__Endpoints__Grpc__Url=http://+:8081 \
    Kestrel__Endpoints__Grpc__Protocols=Http2 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    TMPDIR=/tmp

USER appuser

EXPOSE 8080 8081
ENTRYPOINT ["dotnet", "Api.dll"]
