# Build stage
FROM dhi.io/dotnet:10.0.103-sdk-alpine3.22 AS build
WORKDIR /src

# Copy project files and restore as distinct layers for better caching
COPY ["src/backend/Directory.Build.props", "./"]
COPY ["src/backend/Directory.Packages.props", "./"]
COPY ["global.json", "./"]
COPY ["src/backend/BuildingBlocks/BuildingBlocks/BuildingBlocks.csproj", "BuildingBlocks/BuildingBlocks/"]
COPY ["src/backend/BuildingBlocks/Validation/Validation.csproj", "BuildingBlocks/Validation/"]
COPY ["src/backend/Hosts/Auth/Auth.csproj", "Hosts/Auth/"]

# Restore dependencies
RUN dotnet restore "Hosts/Auth/Auth.csproj" --use-current-runtime

# Copy source code
COPY ["src/backend/BuildingBlocks/", "BuildingBlocks/"]
COPY ["src/backend/Hosts/Auth/", "Hosts/Auth/"]

# Publish with optimizations
RUN dotnet publish "Hosts/Auth/Auth.csproj" \
    -c Release \
    -o /app/publish \
    --use-current-runtime \
    --self-contained false \
    --no-restore \
    /p:PublishTrimmed=false \
    /p:PublishSingleFile=false

# Remove unnecessary files
RUN rm -f /app/publish/appsettings.json \
    && rm -f /app/publish/*.pdb \
    && find /app/publish -name "*.xml" -delete

# Runtime stage
FROM dhi.io/aspnetcore:10.0.3-alpine3.22
WORKDIR /app

# Install runtime dependencies and keep the runtime container non-root.
USER root
RUN apk add --no-cache \
    icu-libs \
    && chown -R 65532:65532 /app

# Copy published app
COPY --from=build --chown=65532:65532 /app/publish .

# Set environment variables
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# Switch to non-root user
USER 65532:65532

EXPOSE 8080
ENTRYPOINT ["dotnet", "Auth.dll"]
