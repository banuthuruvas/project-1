{
  "Valkey": {
    "ConnectionString": "application-valkey:6379",
    "InstanceName": "application-session-instance"
  },
  "AllowedHosts": "*",
  "AllowedCORSOrigin": [
    "https://YOUR_DOMAIN/MYAPP/api-auth",
    "https://YOUR_DOMAIN/MYAPP/api-main"
  ],
  "NIEAuthApi": {
    "SubscriptionKey": "CHANGE_ME",
    "BaseUrl": "https://stgapim.nie.edu.sg/nie/AM"
  },
  "ValidSessionTimeInMins": 90,
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Sentry": {
    "Dsn": "CHANGE_ME",
    "Environment": "production",
    "ServiceName": "application-auth",
    "TracesSampleRate": "0.2"
  },
  "OpenTelemetry": {
    "Enabled": true,
    "MetricsEnabled": true,
    "LogsEnabled": true,
    "ExporterEndpoint": ""
  },
  "ExternalIdp": {
    "AzureAd": {
      "Enabled": false,
      "ClientId": "CHANGE_ME",
      "ClientSecret": "CHANGE_ME",
      "TenantId": "CHANGE_ME",
      "RedirectUri": "https://YOUR_DOMAIN/auth/callback/azuread"
    },
    "Google": {
      "Enabled": false,
      "ClientId": "CHANGE_ME",
      "ClientSecret": "CHANGE_ME",
      "RedirectUri": "https://YOUR_DOMAIN/auth/callback/google"
    },
    "AwsCognito": {
      "Enabled": false,
      "ClientId": "CHANGE_ME",
      "ClientSecret": "CHANGE_ME",
      "UserPoolId": "CHANGE_ME",
      "Region": "ap-southeast-1",
      "RedirectUri": "https://YOUR_DOMAIN/auth/callback/cognito"
    }
  }
}
