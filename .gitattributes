# Normalize line endings on commit; let git pick the working-tree EOL by default.
* text=auto

# Shell scripts MUST stay LF — they run in Linux containers (LocalStack init hooks,
# task verify.sh) where CRLF breaks the shebang ("/bin/bash^M: bad interpreter").
*.sh text eol=lf
*.sh.jinja text eol=lf

# Common binary types — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
*.woff binary
*.woff2 binary
