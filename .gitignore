_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# Build cache (allow directories ending in .cache)
*.[Cc]ache
!?*.[Cc]ache/

# SQL Server blobs
*.mdf
*.ldf
*.ndf

# Sensitive .NET config (never commit production secrets)
appsettings.Development.local.json
appsettings.Production.local.json
secrets.json

# ============================================================
# Node.js / Frontend (pnpm monorepo)
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/

# Build output
dist/
dist-ssr/
lib/
!src/frontend/packages/ui/src/lib/
!src/frontend/packages/ui/src/lib/**
.output/

# TypeScript incremental build
*.tsbuildinfo

# Vite local overrides
*.local
!.env.development

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python tooling caches
__pycache__/
*.py[cod]

# ============================================================
# Environment & Secrets
# ============================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
