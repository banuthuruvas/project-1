# EditorConfig: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
indent_style = space
indent_size = 2
# LF, matching .gitattributes `* text=auto`, which normalises every text file to
# LF in the repository and in Linux CI checkouts. Declaring crlf here contradicted
# that and made `dotnet format --verify-no-changes` fail on every LF checkout.
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown files
[*.md]
trim_trailing_whitespace = false

# C# files (4-space indent per .NET convention)
[*.cs]
indent_size = 4

# XML, project files
[*.{xml,csproj,props,targets,sln}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# TypeScript / JavaScript / Vue
[*.{ts,js,vue,tsx,jsx}]
indent_size = 2

# CSS / SCSS / HTML
[*.{css,scss,html}]
indent_size = 2
