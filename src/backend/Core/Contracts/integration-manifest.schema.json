{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nie.edu.sg/schemas/integration-manifest.schema.json",
  "title": "NIE service integration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "applicationKey",
    "publishes",
    "subscribes",
    "grpcProvides",
    "grpcConsumes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "applicationKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "publishes": { "$ref": "#/$defs/events" },
    "subscribes": { "$ref": "#/$defs/events" },
    "grpcProvides": { "$ref": "#/$defs/services" },
    "grpcConsumes": { "$ref": "#/$defs/services" }
  },
  "$defs": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "contract", "contentType"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^nie\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
          },
          "version": { "type": "integer", "minimum": 1 },
          "contract": { "type": "string", "minLength": 3 },
          "contentType": { "const": "application/json" }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "contract", "methods"],
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^nie\\.integration\\.[a-z0-9_.-]+\\.v[1-9][0-9]*\\.[A-Z][A-Za-z0-9]+$"
          },
          "contract": { "type": "string", "pattern": "^Protos/.+\\.proto$" },
          "methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" }
          }
        }
      }
    }
  }
}
