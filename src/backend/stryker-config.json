{
  "stryker-config": {
    "solution": "Backend.sln",
    "reporters": ["html", "progress", "cleartext"],
    "mutation-level": "Standard",
    "coverage-analysis": "perTest",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 10
    },
    "ignore-mutations": ["string"],
    "mutate": [
      "!**/Migrations/**",
      "!**/Protos/**",
      "!**/*.g.cs"
    ]
  }
}
