{
  "name": "NIE Template Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:3": { "version": "10.0" },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24",
      "nodeGypDependencies": false
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "dbaeumer.vscode-eslint",
        "Vue.volar",
        "ms-azuretools.vscode-cosmosdb",
        "GitHub.copilot",
        "ms-playwright.playwright"
      ],
      "settings": {
        "dotnet.defaultSolution": "src/backend/Backend.sln"
      }
    }
  },
  "postCreateCommand": "cd src/backend && dotnet restore && cd ../../src/frontend && npm i -g pnpm@10 && pnpm install",
  "forwardPorts": [5001, 5002, 8001, 8002, 5432, 6379, 4566]
}
